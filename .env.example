# Server-only. Copy to .env.local (gitignored) and restart `pnpm dev`.
#
# Test mode (no domain yet):
#   from must stay beth.t@example.com
#   to must be the SAME email you used to sign up at Resend
#   (if that is not Outlook, set CONTACT_TO_EMAIL to the Resend account email)
#
# Production: verify lucjoosten.nl at resend.com/domains, then:
#   CONTACT_FROM_EMAIL=Luc Joosten <hello@lucjoosten.nl>
#   CONTACT_TO_EMAIL=lhajoosten@outlook.com
RESEND_API_KEY=
CONTACT_TO_EMAIL=lhajoosten@outlook.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
