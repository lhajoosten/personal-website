{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:site": "node --experimental-strip-types scripts/write-site-files.ts",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "check": "oxlint src && oxfmt --check && tsc -b",
    "prepare": "husky"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "marked": "^18.0.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "src/**/*.{ts,tsx}": "oxlint --fix"
  },
  "packageManager": "pnpm@11.18.0"
}
