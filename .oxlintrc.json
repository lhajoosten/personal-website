{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "eslint"],
  "rules": {
    // React best practices & hooks
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["error", { "allowConstantExport": false }],
    "react/no-unstable-nested-components": "warn",
    "react/no-unknown-property": "error",

    // TypeScript strictness
    "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unused-vars": [
      "error",
      { "vars": "all", "args": "after-used", "ignoreRestSiblings": false }
    ],
    "typescript/ban-types": "error",

    // General JS/TS code quality
    "eslint/no-console": "warn",
    "eslint/no-var": "error",
    "eslint/no-debugger": "error",
    "eslint/no-unused-vars": ["error", { "vars": "all", "args": "after-used" }],
    "eslint/eqeqeq": ["error", "always"],
    "eslint/no-fallthrough": "error",
    "eslint/no-duplicate-imports": "error",
    "eslint/no-shadow": "warn",
    "eslint/no-empty-function": "warn",
    "eslint/no-useless-catch": "error",
    "eslint/no-extra-boolean-cast": "error",
    "eslint/no-implicit-coercion": ["warn", { "boolean": true, "number": true, "string": true }]
  }
}
